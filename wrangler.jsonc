{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gliana-mcp-remote",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Branded endpoint. glianalabs.com is on Cloudflare, so deploy auto-provisions
  // the DNS record + TLS cert. MCP endpoint becomes https://mcp.glianalabs.com/mcp
  "routes": [{ "pattern": "mcp.glianalabs.com", "custom_domain": true }],
  // v2 deletes GlianaMCP and ALL its storage: one Durable Object per MCP
  // session, never cleaned up (6.67k objects / 680 MB on 2026-10-25). The
  // server is stateless now (src/index.ts), so nothing in them is needed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GlianaMCP"] },
    { "tag": "v2", "deleted_classes": ["GlianaMCP"] }
  ],
  "vars": {
    "GLIANA_API_URL": "https://api.glianalabs.com"
  }
}
